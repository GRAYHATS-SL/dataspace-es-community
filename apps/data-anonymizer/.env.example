# Copia este fichero a .env y ajusta los valores.

# ── Pseudonimizacion ─────────────────────────────────────────────────────────
# Clave secreta de los alias (HMAC-SHA256). Con la misma clave, el mismo dato
# produce siempre el mismo alias; sin ella, nadie puede recalcularlos.
# Genera una:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Si la dejas vacia se usa una aleatoria y los alias cambian en cada reinicio.
ANON_SECRET=cambia-este-secreto
# Longitud de los alias (4-32). 8 caracteres base32 = 40 bits.
ANON_ALIAS_LENGTH=8

# ── Politicas ────────────────────────────────────────────────────────────────
POLICIES_DIR=policies
# Politica que se usa cuando la peticion no indica ?policy=
DEFAULT_POLICY=auto

# ── Deteccion ────────────────────────────────────────────────────────────────
# Modelo de spaCy para reconocer nombres, lugares y organizaciones. Vacio =
# solo reglas. Requiere: pip install .[ner] && python -m spacy download <modelo>
#   es_core_news_sm (rapido, menos preciso) | es_core_news_md | es_core_news_lg
#   en_core_web_sm para ingles, etc.
NER_MODEL=
# Fichero adicional de nombres de pila (uno por linea) para ampliar la lista.
DETECTION_NAMES_FILE=

# ── Archivos ─────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=100
MAX_JSON_MB=10
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_TIMEOUT_SECONDS=120

# ── API ──────────────────────────────────────────────────────────────────────
# Claves de acceso separadas por comas (cabecera X-API-Key). Vacio = sin auth.
API_KEYS=
# Origenes permitidos para llamar desde un navegador, separados por comas.
CORS_ORIGINS=
# false para no publicar /docs, /redoc ni /openapi.json
DOCS_ENABLED=true
# URL publica (si va detras de un proxy) para que "Try it out" apunte bien.
PUBLIC_URL=
LOG_LEVEL=INFO

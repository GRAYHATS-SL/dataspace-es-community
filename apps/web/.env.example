# ─── Session ────────────────────────────────────────────────────────────────
# ≥32 char random string — encrypts session cookies.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# ≥32 char random string — HMAC key for the internal web → reviews-api token.
# Must match TOKEN_SECRET in apps/reviews-api.
# Generate: openssl rand -hex 32
TOKEN_SECRET=

# ─── Identity provider (OIDC) ───────────────────────────────────────────────
# OIDC issuer base URL (no trailing slash) — used to discover the authorize/token endpoints
OIDC_ISSUER_URL=
# Client ID registered for this app in your identity provider
OIDC_CLIENT_ID=
# Client secret for the Authorization Code exchange — server-side only, never in client code
OIDC_CLIENT_SECRET=
# JWKS endpoint used to verify the signature of the ID/access tokens
OIDC_JWKS_URI=

# ─── App URL ─────────────────────────────────────────────────────────────────
# Public base URL of the app (no trailing slash)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── TM Forum backend ────────────────────────────────────────────────────────
# Authenticated TM Forum Open API base URL (no trailing slash)
API_BASE_URL=

# Public, unauthenticated TM Forum base URL — used by public catalog pages
CATALOG_PUBLIC_API_BASE_URL=

# ─── reviews-api ─────────────────────────────────────────────────────────────
# Internal base URL of reviews-api (never exposed to the browser)
REVIEWS_API_BASE_URL=http://localhost:4000

# Consumed by the reviews-db and reviews-api services in docker-compose.yml
REVIEWS_DB_USER=
REVIEWS_DB_PASSWORD=
REVIEWS_DB_NAME=

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# SMTP server for transactional emails
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
# "From" address shown in outgoing emails — e.g. no-reply@example.com
SMTP_SENDER=
# SMTP port (optional, defaults to 465 with TLS)
SMTP_PORT=

# ─── Onboarding ──────────────────────────────────────────────────────────────
# ≥32 char random string — HMAC key for the signed onboarding links (openssl rand -hex 32)
ONBOARDING_TOKEN_SECRET=

# ─── External integrations (optional; hidden when unset) ─────────────────────
# Embeddable scheduling page shown in the onboarding wizard (iframe URL)
NEXT_PUBLIC_SCHEDULING_URL=
# External terms/rules document linked from the footer
NEXT_PUBLIC_TERMS_DOCUMENT_URL=
# Public repository URL with the source code (AGPL-3.0 §13); shown in the footer
NEXT_PUBLIC_SOURCE_CODE_URL=

# ─── Sentry ──────────────────────────────────────────────────────────────────
# DSN from your Sentry project settings
NEXT_PUBLIC_SENTRY_DSN=

# Set to "true" to enable Sentry outside production (e.g. staging). Never fires in NODE_ENV=development regardless of this value.
NEXT_PUBLIC_SENTRY_ENABLED=
SENTRY_ENABLED=

# Release identifier sent to Sentry — in CI, set to git SHA or tag
NEXT_PUBLIC_SENTRY_RELEASE=

# Auth token for uploading source maps to Sentry (CI only, never expose to browser)
SENTRY_AUTH_TOKEN=

# Sentry organization and project slugs — used by the build plugin to upload source maps
SENTRY_ORG=
SENTRY_PROJECT=

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Secret key — server-side only (Server Actions / route handlers). Never in client code.
STRIPE_SECRET_KEY=

# Publishable key — client-accessible, initializes Stripe.js
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

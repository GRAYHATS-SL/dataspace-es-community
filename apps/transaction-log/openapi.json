    "/transactions/{hash}/retry": {
      "post": {
        "operationId": "retryTransaction",
        "summary": "Reintentar el sellado de una operación",
        "tags": [
          "Transactions"
        ],
        "description": "Para registros en estado failed o pending. Primero comprueba si un intento anterior llegó a la blockchain (p. ej. tras un CONFIRMATION_TIMEOUT) y, si es así, solo actualiza el registro; si no, vuelve a enviar el mismo hash. Si el registro ya está confirmed lo devuelve sin hacer nada (idempotente).",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            },
            "example": "0xa5afb113865f4c52edc0e260254deacafb729a6af6d83481e13d32e498156e3b",
            "in": "path",
            "name": "hash",
            "required": true,
            "description": "Hash de la operación: 0x + 64 caracteres hexadecimales (se aceptan mayúsculas, se normaliza a minúsculas)."
          }
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Registro confirmado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Petición inválida (VALIDATION_ERROR).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Falta o es incorrecta la cabecera x-api-key (UNAUTHORIZED). Solo si el servicio tiene API_KEY.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No existe ningún registro con ese hash (NOT_FOUND).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Error inesperado (INTERNAL_ERROR).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "La blockchain volvió a fallar; el registro sigue en estado failed (ver record).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }

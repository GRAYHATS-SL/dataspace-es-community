    "/transactions/verify": {
      "post": {
        "operationId": "verifyPayload",
        "summary": "Verificar datos aportados (campos + salt)",
        "tags": [
          "Verification"
        ],
        "description": "Para quien tiene los datos de una operación y su salt (p. ej. un auditor): recalcula el hash y comprueba en la blockchain si está registrado y desde qué fecha. No se fía del log; solo indica si además existe en él. Responde 200 tanto si verifica como si no: mirar el campo verified. Solo lectura, no gasta gas.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id_product_order",
                  "id_product_offer",
                  "id_buyer",
                  "salt"
                ],
                "properties": {
                  "id_product_order": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255,
                    "pattern": "^\\S(.*\\S)?$",
                    "description": "Identificador del pedido. Es único: un mismo pedido solo se puede registrar una vez (un segundo envío devuelve 409).",
                    "examples": [
                      "ORD-DEMO-0001"
                    ]
                  },
                  "id_product_offer": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255,
                    "pattern": "^\\S(.*\\S)?$",
                    "description": "Identificador de la oferta de producto.",
                    "examples": [
                      "OFF-500"
                    ]
                  },
                  "id_buyer": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255,
                    "pattern": "^\\S(.*\\S)?$",
                    "description": "Identificador del comprador.",
                    "examples": [
                      "BUY-777"
                    ]
                  },
                  "salt": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{64}$",
                    "description": "Salt con el que se calculó el hash (32 bytes en hex con prefijo 0x), tal como lo devolvió el registro.",
                    "examples": [
                      "0x839ba520aefeb7ce9678eb26a2e88db9a7cd30153b76e794acbb0d6bd57b0990"
                    ]
                  }
                },
                "title": "VerifyPayloadInput",
                "additionalProperties": false,
                "description": "Datos de una operación + su salt, aportados por quien quiere verificarla (p. ej. un auditor). El servicio recalcula el hash y lo busca en la blockchain sin fiarse del log."
              },
              "example": {
                "id_product_order": "ORD-DEMO-0001",
                "id_product_offer": "OFF-500",
                "id_buyer": "BUY-777",
                "salt": "0x839ba520aefeb7ce9678eb26a2e88db9a7cd30153b76e794acbb0d6bd57b0990"
              }
            }
          },
          "description": "Datos de una operación + su salt, aportados por quien quiere verificarla (p. ej. un auditor). El servicio recalcula el hash y lo busca en la blockchain sin fiarse del log."
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Resultado de la verificación.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Petición inválida (VALIDATION_ERROR).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Falta o es incorrecta la cabecera x-api-key (UNAUTHORIZED). Solo si el servicio tiene API_KEY.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Error inesperado (INTERNAL_ERROR).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "No se pudo consultar la blockchain (BLOCKCHAIN_UNAVAILABLE).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },

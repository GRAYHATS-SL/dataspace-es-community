# ------------------------------------------------------------------ Servicio
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# URL con la que se publica el servicio (aparece en el Swagger)
PUBLIC_URL=http://localhost:3000
# Si se define, las rutas /transactions exigen la cabecera x-api-key con este valor
# API_KEY=

# ------------------------------------------------------------------ Base de datos
# MongoDB del docker-compose (puerto 27018 en el host para no chocar con otros MongoDB).
# El usuario es el root creado por el contenedor, de ahí authSource=admin
MONGODB_URI=mongodb://transaction_log:transaction_log@localhost:27018/?authSource=admin
MONGODB_DB=transaction_log
# Crea/actualiza la colección transaction_log, su validador e índices al arrancar
DB_SETUP_ON_START=true

# ------------------------------------------------------------------ Blockchain
# isbe: registra en una red ISBE (hoy la local de mi-contrato) · mock: simulada en memoria
BLOCKCHAIN_MODE=isbe

ISBE_NETWORK_NAME=isbe-local
ISBE_RPC_URL=http://127.0.0.1:8545
ISBE_CHAIN_ID=11073
# Proxy HashTimestamp desplegado con mi-contrato/scripts/hashtimestamp/deployHashTimestamp.ts
# (ver mi-contrato/deployments/hashtimestamp.11073.json)
ISBE_HASH_TIMESTAMP_ADDRESS=0x98717d1775AE066A18fad55142A5A85EbfA3E067
# Cuenta con HASH_TIMESTAMP_ROLE en ese proxy. Esta es la Account #0 de Hardhat:
# clave PÚBLICA, válida solo para la red local. En la red real usar KMS, nunca una clave en claro.
ISBE_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Espera máxima de confirmación por transacción y de cada llamada RPC
ISBE_CONFIRMATION_TIMEOUT_MS=30000
ISBE_RPC_TIMEOUT_MS=10000

# Solo con BLOCKCHAIN_MODE=mock: latencia simulada de minado
MOCK_LATENCY_MS=200

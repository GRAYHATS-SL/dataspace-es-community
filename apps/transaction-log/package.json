{
  "name": "transaction-log",
  "version": "0.1.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "openapi:export": "tsx src/scripts/exportOpenapi.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/jsonHash.test.ts test/api.test.ts test/mongoRepository.test.ts",
    "db:setup": "tsx src/scripts/setupDb.ts"
  },
  "description": "Servicio que registra operaciones de pedido: hashea el JSON con salt, sella el hash en la blockchain y guarda el registro en MongoDB",
  "dependencies": {
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^18.0.8",
    "ethers": "^6.17.0",
    "fastify": "^5.12.7",
    "mongodb": "^7.7.0",
    "typebox": "^1.3.37"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.19"
  }
}

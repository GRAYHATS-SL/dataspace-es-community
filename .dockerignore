# ─── Version control ─────────────────────────────────────────────────────────
.git
.gitignore

# ─── Node / pnpm ─────────────────────────────────────────────────────────────
node_modules
apps/*/node_modules
**/node_modules

# ─── Next.js build artefacts ─────────────────────────────────────────────────
apps/web/.next
apps/web/out

# ─── Environment files (never copy into the image) ───────────────────────────
.env
.env.*
!.env.example

# ─── Test & coverage ─────────────────────────────────────────────────────────
coverage
apps/web/coverage
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
vitest.config.*

# ─── Dev tooling ─────────────────────────────────────────────────────────────
.husky
.eslintcache
*.tsbuildinfo
apps/web/*.tsbuildinfo

# ─── Documentation ───────────────────────────────────────────────────────────
README.md
docs

# ─── OS artefacts ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Docker ──────────────────────────────────────────────────────────────────
Dockerfile
docker-compose*.yml
.dockerignore
